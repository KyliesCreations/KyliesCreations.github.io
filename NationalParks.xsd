<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="NationalParks">
<xs:complexType>
<xs:sequence>
<xs:element name="NationalPark" maxOccurs = "unbounded">
  <xs:complexType>
  <xs:sequence>
  <xs:element name="Name" maxOccurs = "1" type="xs:string">
  </xs:element>
  <xs:element name="Phone" maxOccurs = "unbounded" type="xs:string">
  </xs:element>
  <xs:element name="Address" maxOccurs = "1">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Number" maxOccurs = "1" type="xs:string">
        </xs:element>
        <xs:element name="Street" maxOccurs = "1" type="xs:string">
        </xs:element>
        <xs:element name="City" maxOccurs = "1" type="xs:string">
        </xs:element>
        <xs:element name="State" maxOccurs = "1" type="xs:string">
        </xs:element>
        <xs:element name="Zip" maxOccurs = "1" type="xs:string">
        </xs:element>
      </xs:sequence>
      <xs:attribute name="NearestAirport" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  </xs:sequence>
  <xs:attribute name="Rating" type="xs:decimal" use="optional"/>
  </xs:complexType>
</xs:element>
</xs:sequence>
</xs:complexType>
</xs:element>
</xs:schema>
